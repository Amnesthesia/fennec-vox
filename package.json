{
  "name": "fennec-vox",
  "version": "1.0.0",
  "description": "EPUB/PDF to audiobook — Electron desktop app + CLI",
  "main": "out/main/index.js",
  "packageManager": "pnpm@10.33.0",
  "bin": {
    "fennec-vox": "./dist/cli/convert.js"
  },
  "scripts": {
    "dev": "pnpm run build-cli && electron-vite dev",
    "build": "electron-vite build",
    "build-cli": "esbuild src/cli/convert.ts --bundle --platform=node --target=node20 --outfile=dist/cli/convert.js --external:aws-sdk --external:ffmpeg-static --loader:.html=empty",
    "build:all": "pnpm run build && pnpm run build-cli",
    "build-web": "vite build --config vite.web.config.ts",
    "dev-web": "vite --config vite.web.config.ts",
    "preview": "electron-vite preview",
    "lint": "biome check",
    "lint:fix": "biome check --write --unsafe",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.cli.json && tsc --noEmit -p tsconfig.web.json",
    "package:sign": "pnpm run build:all && electron-builder --mac",
    "package": "pnpm run build:all && electron-builder --mac -c.mac.identity=null",
    "generate-previews": "tsx scripts/generate-voice-previews.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "buffer": "^6.0.3",
    "cheerio": "^1.0.0",
    "epub2": "^3.0.2",
    "ffmpeg-static": "^5.3.0",
    "fs-extra": "^11.2.0",
    "jszip": "^3.10.1",
    "keytar": "^7.9.0",
    "openai": "^4.67.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^6.0.227",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/ffmpeg-static": "^5.1.0",
    "@types/fs-extra": "^11.0.4",
    "@types/jsdom": "^28.0.3",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/yargs": "^17.0.33",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.8",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "electron-builder-notarize": "^1.5.2",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.3",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "keytar",
      "ffmpeg-static"
    ]
  },
  "build": {
    "appId": "com.fennecvox.app",
    "productName": "Fennec Vox",
    "icon": "build/icon.icns",
    "afterSign": "electron-builder-notarize",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "protocols": [
        {
          "name": "Fennec Vox",
          "schemes": [
            "fennecvox"
          ]
        }
      ],
      "identity": "Apple Development: Victor Rudolfsson (Y9T55LH62G)",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "gatekeeperAssess": false
    },
    "extraResources": [
      {
        "from": "./dist/cli/convert.js",
        "to": "convert.js"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg",
        "to": "ffmpeg"
      }
    ]
  }
}